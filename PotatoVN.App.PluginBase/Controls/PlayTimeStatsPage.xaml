<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PotatoVN.App.PluginBase.Controls.PlayTimeStatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PotatoVN.App.PluginBase.Models"
    xmlns:vm="using:PotatoVN.App.PluginBase.ViewModels"
    xmlns:converter="using:PotatoVN.App.PluginBase.Controls.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:ImagePathConverter x:Key="ImagePathConverter" />
        <converter:MinutesToWidthConverter x:Key="MinutesToWidthConverter" />

        <!-- Bar row template for the horizontal bar chart -->
        <DataTemplate x:Key="BarRowTemplate" x:DataType="models:BarChartItem">
            <Button Padding="0" BorderThickness="0" Background="Transparent"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Click="BarRow_Click" Tag="{x:Bind}">
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Y-axis label -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Label}" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{x:Bind SubLabel}" FontSize="11" Opacity="0.5"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Bar track + fill -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Height="28"
                          HorizontalAlignment="Stretch">
                        <Border CornerRadius="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                Opacity="0.5" />
                        <Border CornerRadius="4" Height="28" VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="{x:Bind BarBrush}"
                                Width="{x:Bind WidthRatio, Converter={StaticResource MinutesToWidthConverter}, ConverterParameter=280, Mode=OneWay}" />
                    </Grid>

                    <!-- Value label -->
                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                               Text="{x:Bind DisplayTime}" FontSize="13"
                               Foreground="{x:Bind BarBrush}" FontWeight="SemiBold"
                               MinWidth="56" HorizontalAlignment="Right" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Game ranking item template -->
        <DataTemplate x:Key="RankItemTemplate" x:DataType="models:GameRankItem">
            <Grid ColumnSpacing="12" Padding="8,8,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Game icon -->
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Background>
                        <ImageBrush ImageSource="{x:Bind ImagePath, Converter={StaticResource ImagePathConverter}, FallbackValue={x:Null}}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <!-- Name + percentage bar -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <Grid Height="6" CornerRadius="3" HorizontalAlignment="Stretch"
                          Background="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.5">
                        <Border CornerRadius="3" HorizontalAlignment="Left"
                                Background="{x:Bind BarBrush}"
                                Width="{x:Bind WidthRatio, Converter={StaticResource MinutesToWidthConverter}, ConverterParameter=200, Mode=OneWay}" />
                    </Grid>
                </StackPanel>

                <!-- Time + percentage -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind DisplayTime}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{x:Bind BarBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="{x:Bind Percentage}" FontSize="11" Opacity="0.6"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer Padding="40,24,40,24" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">

                <!-- Header: title + period tabs -->
                <Grid ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Name="TitleText"
                                   FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.PeriodDescription, Mode=OneWay}"
                                   FontSize="13" Opacity="0.6" />
                    </StackPanel>

                    <!-- Day / Week / Month selector -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="8" Padding="4">
                        <Button x:Name="DayBtn"
                                Style="{StaticResource PeriodTabButtonStyle}"
                                Click="DayBtn_Click" />
                        <Button x:Name="WeekBtn"
                                Style="{StaticResource PeriodTabButtonStyle}"
                                Click="WeekBtn_Click" />
                        <Button x:Name="MonthBtn"
                                Style="{StaticResource PeriodTabButtonStyle}"
                                Click="MonthBtn_Click" />
                    </StackPanel>
                </Grid>

                <!-- Summary card: total play time -->
                <Border CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" Padding="24,16,24,16">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7BC;" FontSize="32"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TotalPlayTimeLabel"
                                       FontSize="12" Opacity="0.6" />
                            <TextBlock Text="{x:Bind ViewModel.TotalDisplayTime, Mode=OneWay}"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <!-- Filter hint + clear button -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4"
                                    Orientation="Horizontal" Visibility="{x:Bind ShowFilterHint, Mode=OneWay}">
                            <InfoBar Severity="Informational"
                                     IsOpen="True"
                                     Title="{x:Bind ViewModel.FilterHint, Mode=OneWay}"
                                     IsClosable="False"
                                     Margin="0" />
                            <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons"
                                    FontSize="14" Padding="8,4,8,4"
                                    Click="ClearFilter_Click"
                                    ToolTipService.ToolTip="Clear filter" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bar chart section -->
                <Border CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" Padding="20,16,20,16">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="TimeDistributionLabel"
                                   FontSize="16" FontWeight="SemiBold" />
                        <ListView ItemsSource="{x:Bind ViewModel.BarItems, Mode=OneWay}"
                                  ItemTemplate="{StaticResource BarRowTemplate}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  Background="Transparent"
                                  BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- Game ranking section -->
                <Border CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" Padding="20,16,20,16">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="GameRankingLabel"
                                   FontSize="16" FontWeight="SemiBold" />
                        <ListView ItemsSource="{x:Bind ViewModel.RankItems, Mode=OneWay}"
                                  ItemTemplate="{StaticResource RankItemTemplate}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  Background="Transparent"
                                  BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- Empty state -->
                <StackPanel Visibility="{x:Bind NoDataVisibility, Mode=OneWay}"
                            HorizontalAlignment="Center" Spacing="12" Padding="0,40,0,40">
                    <FontIcon Glyph="&#xE81C;" FontSize="48" Opacity="0.3" />
                    <TextBlock x:Name="NoDataText"
                               FontSize="14" Opacity="0.5" HorizontalAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>