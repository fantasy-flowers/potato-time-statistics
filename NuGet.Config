<?xml version="1.0" encoding="utf-8"?>
<!--
  Workspace-level NuGet config written by Vibe.Backend's ensure_workspace.
  Pins the package cache so terminal restore and MCP build_plugin share
  the same nuget-cache regardless of NUGET_PACKAGES env var. Safe to keep
  in version control: the path is local to this Vibe machine and the
  workspace itself never leaves it (no remote configured).
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".nuget\packages" />
  </config>
</configuration>
